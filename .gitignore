# Secrets & credentials
.credentials*
**/.credentials*
*.credentials
credentials.json

# Common secret / env files
.env
.env.*
*.key
*.pem
*.p12
*.pfx
secrets.*
*.secret
*_secret*
id_rsa
id_rsa.*
*.token
.npmrc

# Machine-local Claude Code settings — contain absolute paths and
# per-machine permission grants; never belong in the shared repo.
.claude/settings.local.json

# Local working notes — session runbooks and scratch planning. Kept out of the
# repo deliberately: this repo has readers beyond its author, and working notes
# are written for one reader and rarely read well by the others.
/ROLLOUT.md
/NOTES.md

# OS / editor cruft
.DS_Store
Thumbs.db
